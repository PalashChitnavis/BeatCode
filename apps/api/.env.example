NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public origin of the web app (CORS, OAuth redirects).
WEB_ORIGIN=http://localhost:5173
# Public origin of this API (OAuth callback URL).
API_ORIGIN=http://localhost:4000

DATABASE_URL=postgresql://beatcode:beatcode@localhost:5432/beatcode
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OAUTH_STATE_SECRET=change-me-to-another-long-random-string-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# "lax" when web and API share a site, "none" when they are on different domains (requires HTTPS).
COOKIE_SAMESITE=lax
# Number of reverse proxies (load balancer, nginx) in front of the API.
TRUST_PROXY=0

# Optional: leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI tutor. Free by default: "gemini" with a key from https://aistudio.google.com/apikey
# created in a Google Cloud project WITHOUT a billing account (free tier only, never charged;
# over quota it returns 429). "ollama" runs a local model instead; "none" disables the feature.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# App-side caps, independent of the provider's own limits.
AI_DAILY_LIMIT_PER_USER=25
AI_DAILY_LIMIT_GLOBAL=200
AI_MAX_OUTPUT_TOKENS=1024
